<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+（API 31+）不再读 fullBackupContent，改读这个文件。
  不声明的话系统按默认规则全量备份 —— 加密口令会随云备份和换机迁移被带走，
  而 backup_rules.xml 里那条 exclude 在 12+ 上完全被忽略。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lanmesh_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lanmesh_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
