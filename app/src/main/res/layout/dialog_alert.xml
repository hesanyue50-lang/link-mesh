<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:padding="20dp">

    <TextView
        android:id="@+id/dlg_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text"
        android:textSize="17sp"
        android:textStyle="bold"
        android:text="标题" />

    <TextView
        android:id="@+id/dlg_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_dim"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:text="内容" />

    <EditText
        android:id="@+id/dlg_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input"
        android:padding="12dp"
        android:textColor="@color/text"
        android:textColorHint="@color/text_faint"
        android:textSize="14sp"
        android:singleLine="true"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dlg_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_ghost"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:text="取消"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dlg_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_primary"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:textColor="@color/bg"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="知道了" />
    </LinearLayout>
</LinearLayout>
