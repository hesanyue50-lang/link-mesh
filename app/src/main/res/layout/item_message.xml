<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/msg_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/msg_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="3dp"
        android:textColor="@color/text_faint"
        android:textSize="9sp"
        android:typeface="monospace"
        android:text="00-00 00:00" />

    <LinearLayout
        android:id="@+id/msg_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bubble_in"
        android:padding="11dp">

        <TextView
            android:id="@+id/msg_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:text="" />

        <LinearLayout
            android:id="@+id/msg_file_box"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/msg_file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="middle"
                android:text="file.bin" />

            <TextView
                android:id="@+id/msg_file_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_faint"
                android:textSize="9sp"
                android:typeface="monospace"
                android:text="0 B" />

            <ProgressBar
                android:id="@+id/msg_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_progress" />

            <TextView
                android:id="@+id/msg_file_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/accent"
                android:textSize="9sp"
                android:typeface="monospace"
                android:text="0%" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
