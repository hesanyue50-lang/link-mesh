<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dlg_sig_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text"
        android:textSize="17sp"
        android:textStyle="bold"
        android:text="邀请码" />

    <TextView
        android:id="@+id/dlg_sig_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:text="复制后发给对方" />

    <ImageView
        android:id="@+id/dlg_sig_qr"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="#FFFFFFFF"
        android:padding="8dp"
        android:visibility="gone"
        android:contentDescription="信令二维码" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:padding="10dp">

        <TextView
            android:id="@+id/dlg_sig_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="10sp"
            android:typeface="monospace"
            android:textIsSelectable="true"
            android:text="" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dlg_sig_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_ghost"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="复制"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dlg_sig_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_primary"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="关闭"
            android:textColor="@color/on_accent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
