<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 三页横向分页：跟手拖动，松手按速度吸附（见 PanelPager）
         全屏铺满，内容从悬浮导航下面穿过 -->
    <com.jiuyue.lanmesh.ui.PanelPager
        android:id="@+id/panel_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/page_row"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <include
                android:id="@+id/page_lan"
                layout="@layout/view_lan"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/page_p2p"
                layout="@layout/view_p2p"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/page_tools"
                layout="@layout/view_tools"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/page_settings"
                layout="@layout/view_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </com.jiuyue.lanmesh.ui.PanelPager>

    <!-- 内容淡出遮罩：滚动内容在悬浮导航上方渐隐，是"浮起来"的关键 -->
    <View
        android:id="@+id/nav_scrim"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_nav_scrim" />

    <!-- 悬浮胶囊导航：一个独立的滑块 View 由滚动进度驱动，不播放动画器 -->
    <FrameLayout
        android:id="@+id/nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:id="@+id/seg_wrap"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_nav"
            android:padding="5dp">

            <View
                android:id="@+id/nav_slider"
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_nav_active" />

            <LinearLayout
                android:id="@+id/seg_tabs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/nav_lan"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_nav_lan"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/tab_lan"
                        app:srcCompat="@drawable/ic_nav_lan" />

                    <TextView
                        android:id="@+id/tv_nav_lan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/tab_lan"
                        android:textColor="@color/nav_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_p2p"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_nav_p2p"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/tab_p2p"
                        app:srcCompat="@drawable/ic_nav_p2p" />

                    <TextView
                        android:id="@+id/tv_nav_p2p"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/tab_p2p"
                        android:textColor="@color/nav_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_tools"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_nav_tools"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/tab_tools"
                        app:srcCompat="@drawable/ic_nav_tools" />

                    <TextView
                        android:id="@+id/tv_nav_tools"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/tab_tools"
                        android:textColor="@color/nav_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_settings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_nav_settings"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/tab_settings"
                        app:srcCompat="@drawable/ic_nav_settings" />

                    <TextView
                        android:id="@+id/tv_nav_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/tab_settings"
                        android:textColor="@color/nav_text"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
