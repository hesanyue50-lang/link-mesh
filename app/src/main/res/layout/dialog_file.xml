<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dlg_file_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="file.bin" />

    <TextView
        android:id="@+id/dlg_file_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_faint"
        android:textSize="10sp"
        android:typeface="monospace"
        android:text="/storage/..." />

    <TextView
        android:id="@+id/dlg_file_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_btn_ghost"
        android:gravity="center"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="打开"
        android:textColor="@color/text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/dlg_file_locate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_btn_ghost"
        android:gravity="center"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="定位文件位置"
        android:textColor="@color/text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/dlg_file_delete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_btn_ghost"
        android:gravity="center"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="删除文件和记录"
        android:textColor="@color/danger"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/dlg_file_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:text="取消"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />
</LinearLayout>
