<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      主题用 DayNight：跟随系统 / 强制浅色 / 强制深色 由 AppCompatDelegate 控制，
      三种模式共用同一套布局，只换 values 与 values-night 的颜色。
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:windowNoTitle">true</item>
        <item name="alertDialogTheme">@style/DarkDialogTheme</item>
        <item name="android:alertDialogTheme">@style/DarkDialogTheme</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:textColorHint">@color/text_faint</item>
    </style>

    <!-- 自绘对话框主题：背景透明（圆角由布局自己画），避免系统默认亮色弹窗 -->
    <style name="DarkDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
    </style>

    <!-- 字阶：display 34 / title1 24 / title2 18 / body 15 / caption 12 / label 11 -->
    <style name="TextDisplay">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextTitle1">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextTitle2">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="TextBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextCaption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_dim</item>
    </style>

    <style name="TextLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_faint</item>
    </style>

    <style name="TextMono">
        <item name="android:typeface">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_faint</item>
    </style>

    <style name="PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="GhostButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="PanelCard">
        <item name="android:background">@drawable/bg_panel</item>
        <item name="android:padding">18dp</item>
    </style>

    <!-- 扫码页：暗色，与主界面一致 -->
    <style name="ScanTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>

    <!-- 底部导航项：未选中用次级文字色，选中由代码染成强调色 -->
    <style name="NavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>
</resources>
